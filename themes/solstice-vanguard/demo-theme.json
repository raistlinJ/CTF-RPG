        "location": {
          "x": 18,
          "y": 17
        },
        "startNode": "welcome",
        "nodes": [
          {
            "id": "welcome",
            "text": "Welcome to the Solstice Vanguard practice mission! Search near the battery at (18,19) for a red key. Visit Gift Foundry for the gold key, then Evergreen Vault, and finish in the Aurora Beacon.",
            "choices": [
              {
                "id": "route",
                "label": "Where should I go?",
                "to": "route"
              },
              {
                "id": "grading",
                "label": "How do answers work?",
                "to": "grading"
              }
            ]
          },
          {
            "id": "route",
            "text": "The aurora puzzle at (11,19) gives the incantation for the shortcut at (16,21). A red key opens Aurora Beacon; a gold key opens Evergreen Vault. Read the Signal Station file before the final boss.",
            "choices": [
              {
                "id": "back",
                "label": "Back",
                "to": "welcome"
              }
            ]
          },
          {
            "id": "grading",
            "text": "Search near stars and bosses. Short answers are checked right away. The last reflection is instructor graded. Hints can cost points; one optional hint at Cocoa Café also gives up its green key.",
            "choices": [
              {
                "id": "back",
                "label": "Back",
                "to": "welcome"
              }
            ]
          }
        ]
      },
      {
        "id": "sv-demo-v1-host",
        "name": "Beacon Keeper",
        "characterId": "beacon-keeper",
        "map": "castle",
        "location": {
          "x": 25,
          "y": 16
