                "to": "cheer"
              }
            ]
          },
          {
            "id": "cheer",
            "text": "What a mission! Enjoy the trophy hall, then use the south airlock to return to the top-left of the commissioning deck.",
            "choices": []
          }
        ]
      },
      {
        "id": "celebration-engineer",
        "name": "Systems Engineer",
        "characterId": "celebration-engineer-look",
        "map": "celebration-hall",
        "location": {
          "x": 11,
