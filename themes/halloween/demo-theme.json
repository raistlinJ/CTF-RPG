        "startNode": "welcome",
        "nodes": [
          {
            "id": "welcome",
            "text": "Welcome to Hollowbrook’s practice adventure! Search near the lantern at (18,19) for a red key. The Potion Atelier holds a gold key, which opens the Ghost Conservatory. Finish in Moonfall Manor after you have read the Raven Post note.",
            "choices": [
              {
                "id": "route",
                "label": "Where should I go next?",
                "to": "route"
              },
              {
                "id": "answers",
                "label": "How do challenges work?",
                "to": "answers"
              }
            ]
          },
          {
            "id": "route",
            "text": "Solve the moon riddle at (11,19) for the incantation that opens the shortcut at (16,21). A red key opens Moonfall Manor, and a gold key opens the Ghost Conservatory. Each reward belongs to the explorer who earned it.",
            "choices": [
              {
                "id": "back",
                "label": "Back",
                "to": "welcome"
              }
            ]
          },
          {
            "id": "answers",
            "text": "Walk near a star or boss and Search nearby. Short answers are checked immediately; the final reflection waits for your instructor. Hints can cost points. At Pumpkin Bakery, revealing the answer also gives up its optional green key.",
            "choices": [
              {
                "id": "back",
                "label": "Back",
                "to": "welcome"
              }
            ]
          }
        ]
      },
