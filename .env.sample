# Copy to .env in this directory; Docker Compose reads .env automatically.
# These are Compose settings. For npm start:selfhost, export the server
# variables described in SELF_HOSTING.md instead of using /app paths.

# Admin username/password are configured in YAML, not in this file.
# Set admin.protectedUsername and its matching accounts.users admin entry.
GAME_CONFIG=/app/content/game.yaml
# For a private account list, copy content/game.yaml to content/game.local.yaml,
# configure your administrator there, and use this path instead:
# GAME_CONFIG=/app/content/game.local.yaml

# Direct app HTTP listener. Nginx reaches the app over the Compose network.
# Use APP_BIND=0.0.0.0 to allow direct HTTP access from other computers.
APP_BIND=127.0.0.1
APP_PORT=3000

# Exact browser origin without a trailing slash; include nondefault ports.
# HTTPS example: PUBLIC_ORIGIN=https://ctf.example.org
# HTTP example: PUBLIC_ORIGIN=http://192.168.1.50:3000
# Leave empty for local defaults: incoming HTTP host / https://localhost.
PUBLIC_ORIGIN=

# Plain HTTP uses false. compose.https.yaml always enables secure cookies.
SECURE_COOKIES=false

# Optional Nginx HTTPS frontend: docker compose -f compose.https.yaml up --build -d
HTTP_PORT=80
HTTPS_PORT=443
# With HTTPS_PORT=8443, also set PUBLIC_ORIGIN=https://your-server:8443.

# Optional hostname/IP for a generated self-signed certificate.
# Empty uses the hostname/IP from PUBLIC_ORIGIN (localhost by default).
TLS_SERVER_NAME=
# Provide nginx/ssl/fullchain.pem and nginx/ssl/privkey.pem to use your own certs.
# When both are absent, Nginx generates a pair in nginx/ssl and reuses it.
